# Copy this file to .env, then change the values below.
# Do not commit your real .env file.

# Image published for non-technical users. Change this if you publish under another registry.
CPA_MANAGER_IMAGE=ghcr.io/yifengai/cpa-manager:request-log-page

# Local web panel port.
CPA_MANAGER_PORT=18317

# Required: choose your own management key.
CPA_MANAGEMENT_KEY=change-me-please

# Required: local folder containing your Codex auth JSON files.
# Examples:
#   macOS/Linux: /absolute/path/to/CLIProxyAPI-main/auths
#   Windows:     C:/path/to/CLIProxyAPI-main/auths
CPA_CODEX_AUTH_PATH=./auths

# Optional: local folder containing CLIProxyAPI request-log files.
# Enable request-log in CLIProxyAPI first, then point this to its logs directory.
CPA_REQUEST_LOG_PATH=./logs

# Required when cpa-manager should talk to CLIProxyAPI automatically.
# Same Docker network: http://cli-proxy-api:8317
# Docker Desktop host service: http://host.docker.internal:8317
CPA_UPSTREAM_URL=http://cli-proxy-api:8317

# Account pool estimate baseline. These are only local estimate parameters,
# not official quota values.
CODEX_QUOTA_ESTIMATE_TOKENS=4000000
CODEX_QUOTA_ESTIMATE_COST_USD=20
CODEX_QUOTA_ESTIMATE_CALLS=34
